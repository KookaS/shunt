# Handshake Shunt image — the router plus the hermetic fake registry, baked in.
# Self-contained on purpose: no bind mount, so the harness is robust in any CI
# (single-file bind mounts are unreliable across hosts/daemons). Build context is
# THIS directory (tests/integrations/), whose files are NOT .dockerignore'd.
#
# Layered on the product image. Build the base first:
#   docker build -t shunt-router:handshake -f Dockerfile .
ARG SHUNT_BASE_IMAGE=shunt-router:handshake
FROM ${SHUNT_BASE_IMAGE}
COPY fake_registry.yaml /shunt-harness/fake_registry.yaml
# The packaged router.yaml lists the shipped registry's live models; against the
# 3-model fake registry `restrict_to_live` would refuse to boot. Bake a router.yaml
# with `models: []` (route over the whole registry) and point SHUNT_CONFIG_DIR at it.
COPY fake_router.yaml /shunt-harness/router.yaml
ENV SHUNT_MODEL_CONFIG_PATH=/shunt-harness/fake_registry.yaml
ENV SHUNT_CONFIG_DIR=/shunt-harness

# The escalation scenario's deterministically-red repo, BAKED IN for the same reason the
# registry is. A bind mount here is not merely inelegant: when the docker daemon does not
# share the client's filesystem (a devcontainer, a remote daemon, rootless CI), the source
# path silently resolves to an empty directory on the daemon host, /repo has no test suite,
# every capture returns "no tests ran", and the scenario reports a false negative — the very
# class of lie this harness exists to remove.
COPY demo_repo /repo

# The off-wire verifier shells out to `sys.executable -m pytest` in the work dir, and
# the product image ships no test runner (correctly — it is not the router's job). The
# escalation scenario is the one place Shunt must run someone else's suite, so pytest is
# a HARNESS-layer dep here, never in the shipped image.
RUN pip install --no-cache-dir "pytest>=8,<9"

# The scenario's verdict sidecar. Baked in, not bind-mounted, for the same reason the
# registry is: one self-contained image works on any daemon. It runs with the entrypoint
# overridden (see the `assert-escalation` service in examples/integrations/compose.base.yaml).
COPY assert_escalation.py /shunt-harness/assert_escalation.py
