# Copy to `.env` (gitignored — never committed) and fill in your keys.
#
# Loaded automatically by:
#   - the benchmark:  `python -m benchmark.runner.run_matrix --live`
#   - the router CLI: `shunt start`
#   - the wrapper Makefile launchers (`make opencode` / `opencode-wt`)
# Real environment variables always take precedence over this file.
#
# Each provider row in the registry names the variable it reads
# (`api_key_env_var` in src/shunt/config/models.yaml). Set the ones you
# use; the rest are ignored. See docs/configuration.md.

# Aggregators — one key, many vendors.
REQUESTY_API_KEY=
OPENROUTER_API_KEY=
EXPLABS_API_KEY=

# First-party.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# Open-weight serving.
GROQ_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
NEBIUS_API_KEY=
FIREWORKS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_NIM_API_KEY=

# Free-tier harvest providers (see configs/free-tier/overlay.yaml — collection only).
GOOGLE_AI_STUDIO_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
OPENCODE_API_KEY=
KILO_API_KEY=
HF_TOKEN=
# Cloudflare Workers AI is account-scoped: its base_url embeds the account id as
# ${CLOUDFLARE_ACCOUNT_ID}. The token and the id are both required to reach it.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Anthropic (Claude) — read by the benchmark runner's key set.
ANTHROPIC_API_KEY=

# Local (Ollama / vLLM) needs no key — see examples/providers/local.yaml.
